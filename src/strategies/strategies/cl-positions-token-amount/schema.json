{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Strategy",
  "definitions": {
    "Strategy": {
      "title": "Strategy",
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "title": "Symbol",
          "examples": ["e.g. UNI-LP"],
          "maxLength": 16
        },
        "token": {
          "type": "string",
          "title": "Token counted inside the positions",
          "examples": ["e.g. 0x1f9840a85d5aF5bf1D1762F925BDADdC4201F984"],
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "minLength": 42,
          "maxLength": 42
        },
        "decimals": {
          "type": "number",
          "title": "Token decimals",
          "examples": ["e.g. 18"],
          "minimum": 0
        },
        "sources": {
          "type": "array",
          "title": "Position managers and their pools",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "title": "Position manager type",
                "enum": ["uniswap-v3", "algebra-integral"]
              },
              "positionManager": {
                "type": "string",
                "title": "Position manager (NFT) address",
                "pattern": "^0x[a-fA-F0-9]{40}$",
                "minLength": 42,
                "maxLength": 42
              },
              "stakingContracts": {
                "type": "array",
                "title": "Contracts holding staked position NFTs",
                "items": {
                  "type": "string",
                  "pattern": "^0x[a-fA-F0-9]{40}$",
                  "minLength": 42,
                  "maxLength": 42
                }
              },
              "pools": {
                "type": "array",
                "title": "Pools to count",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "address": {
                      "type": "string",
                      "title": "Pool address",
                      "pattern": "^0x[a-fA-F0-9]{40}$",
                      "minLength": 42,
                      "maxLength": 42
                    },
                    "deployer": {
                      "type": "string",
                      "title": "Pool deployer (Algebra Integral custom pools only)",
                      "pattern": "^0x[a-fA-F0-9]{40}$",
                      "minLength": 42,
                      "maxLength": 42
                    }
                  },
                  "required": ["address"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["type", "positionManager", "pools"],
            "additionalProperties": false
          }
        }
      },
      "required": ["token", "decimals", "sources"],
      "additionalProperties": false
    }
  }
}
